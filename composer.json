{
    "name": "indianopinion/echo-skip-seen",
    "description": "WordPress plugin that skips feed items whose article the site has already imported, before the importer downloads the page.",
    "type": "wordpress-plugin",
    "license": "MIT",
    "keywords": [
        "wordpress",
        "rss",
        "importer",
        "duplicates",
        "echo-rss"
    ],
    "homepage": "https://github.com/IndianOpinion/echo-skip-seen",
    "support": {
        "issues": "https://github.com/IndianOpinion/echo-skip-seen/issues",
        "email": "hello@indianopinion.org"
    },
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "php-stubs/wp-cli-stubs": "^2.11",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.10",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "wp-coding-standards/wpcs": "^3.1"
    },
    "autoload": {
        "psr-4": {
            "IndianOpinion\\EchoSkipSeen\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "IndianOpinion\\EchoSkipSeen\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "lint": "phpcs",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "8.1.0"
        }
    },
    "minimum-stability": "stable"
}
